# ── Browser side (baked in at `npm run build`) ─────────────────────────
# Public address of the site. Same origin serves the site, signalling and permanent rooms.
VITE_SERVER_URL=https://yourdomain.com
VITE_APP_URL=https://yourdomain.com
# AGPL-3.0: link to the public source of THIS version (your fork)
VITE_SOURCE_URL=https://github.com/YOUR_GITHUB_USER/pulsarchat
# TURN relay for ghost rooms (WebRTC) behind strict NATs / mobile networks
VITE_TURN_URL=turn:free.expressturn.com:3478
VITE_TURN_USERNAME=your_expressturn_username
VITE_TURN_CREDENTIAL=your_expressturn_credential
# Optional: feedback form
VITE_WEB3FORMS_KEY=your_web3forms_key

# ── Server side (read by server.js at runtime; on the VPS these live in /etc/pulsarchat.env) ──
NODE_ENV=production
# Listen address. Production default is 127.0.0.1 (reachable only through the Cloudflare Tunnel).
HOST=127.0.0.1
PORT=9000
# true ONLY when the app is reachable exclusively through Cloudflare (reads CF-Connecting-IP)
TRUST_PROXY=true
# Exact browser origins allowed to open WebSockets (comma separated, no trailing slash)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# SQLite file for permanent rooms (back this up!)
DATABASE_PATH=/var/lib/pulsarchat/pulsar.db
STATS_SECRET=change_me_to_a_long_random_string

# Permanent-room limits (defaults shown; all optional)
# ROOM_MAX_BYTES=524288000
# MAX_TEXT_BYTES=65536
# MAX_IMAGE_BYTES=1048576
# MIN_FREE_DISK_BYTES=2147483648
# SOCKET_MESSAGES_PER_10S=20
# CONNECTIONS_PER_MINUTE_PER_IP=30
# NEW_ROOMS_PER_HOUR_PER_IP=20

# Optional: Firebase push (Android app only)
# FIREBASE_SERVICE_ACCOUNT={"project_id":"..."}
